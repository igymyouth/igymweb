---
import IGEO_LOGO from "../media/igeo-logo.jpeg"; // Ensure path matches your setup

const year = new Date().getFullYear();
---

<footer class="site-footer dark">
  <div class="container footer-inner">
    <div class="footer-col brand-col">
      <p class="footer-brand">I-GYM</p>
      <p class="footer-desc">International Geoscience Youth Movement — a global network of student chapters mapping, measuring, and speaking up for the planet.</p>
    </div>

    <div class="footer-col">
      <p class="footer-heading">Explore</p>
      <ul>
        <li><a href="/about">About us</a></li>
        <li><a href="/youth-leaders">Youth Leaders</a></li>
        <li><a href="/events">Events</a></li>
        <li><a href="/get-involved">Get Involved</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <p class="footer-heading">Connect</p>
      <ul>
        <li><a href="mailto:igymyouth@gmail.com">igymyouth@gmail.com</a></li>
        <li><a href="https://instagram.com/igym.official" target="_blank" rel="noreferrer">Instagram</a></li>
      </ul>
    </div>

    <!-- Supported By / IGEO Column -->
    <div class="footer-col partner-col">
      <p class="footer-heading">Supported By</p>
      <a 
        href="https://www.igeoscied.org/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="footer-partner-link"
        aria-label="Supported by International GeoScience Education Organisation"
      >
        <img 
          src={IGEO_LOGO.src} 
          alt="International GeoScience Education Organisation Logo" 
          class="footer-partner-logo" 
        />
      </a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} International Geoscience Youth Movement. Built by young earth scientists, for young earth scientists.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--slate-2);
    padding-top: 3.5rem;
  }
  
  .footer-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line-dark);
  }

  .footer-brand {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 0.75rem;
  }

  .footer-desc { 
    max-width: 34ch; 
    font-size: 0.92rem; 
  }

  .footer-heading {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    color: var(--ochre);
    margin: 0 0 1rem;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-col a {
    text-decoration: none;
    color: rgba(234, 225, 200, 0.78);
    font-size: 0.92rem;
  }

  .footer-col a:hover { 
    color: var(--stone); 
  }

  /* Partner Column Specific Styles */
  .footer-partner-link {
    display: inline-block;
    transition: opacity 0.2s ease;
  }

  .footer-partner-link:hover {
    opacity: 0.8;
  }

  .footer-partner-logo {
    height: 52px;
    width: auto;
    object-fit: contain;
    background: rgba(255, 255, 255, 0.95); /* Lightweight backing for visibility on dark theme */
    padding: 0.35rem 0.6rem;
    border-radius: 4px;
    display: block;
  }

  .footer-bottom {
    padding-block: 1.25rem;
  }

  .footer-bottom p {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: rgba(234, 225, 200, 0.55);
    margin: 0;
  }

  @media (max-width: 780px) {
    .footer-inner { 
      grid-template-columns: 1fr 1fr; 
    }

    .brand-col {
      grid-column: 1 / -1; /* Spans full width on mobile top */
    }
  }
</style>