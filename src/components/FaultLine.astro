---
interface Props {
  from?: string;
  to?: string;
  flip?: boolean;
}
const { from = "var(--stone)", to = "var(--paper)", flip = false } = Astro.props;
---
<div class="fault-line" style={{ transform: flip ? "scaleY(1)" : "none" }} aria-hidden="true">
  <svg viewBox="0 0 1200 40" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path
      d="M0,18 L60,18 L92,6 L140,30 L188,10 L230,22 L280,4 L330,26 L380,14 L430,20 L480,8 L540,28 L600,16 L660,24 L720,6 L780,20 L840,12 L900,26 L960,10 L1020,22 L1080,8 L1140,18 L1200,18 L1200,40 L0,40 Z"
      fill={to}
    ></path>
    <path
      d="M0,18 L60,18 L92,6 L140,30 L188,10 L230,22 L280,4 L330,26 L380,14 L430,20 L480,8 L540,28 L600,16 L660,24 L720,6 L780,20 L840,12 L900,26 L960,10 L1020,22 L1080,8 L1140,18 L1200,18"
      fill="none"
      stroke={to}
      stroke-width="2"
    ></path>
  </svg>
</div>

<style define:vars={{ from }}>
  .fault-line {
    width: 100%;
    line-height: 0;
    background: var(--from);
  }
  .fault-line svg {
    width: 100%;
    height: 28px;
    display: block;
  }
</style>
