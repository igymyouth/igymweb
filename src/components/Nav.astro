---
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About us" },
  { href: "/mentors", label: "Our Mentors" },
  { href: "/youth-leaders", label: "Youth Leaders" },
  { href: "/events", label: "Events" },
  { href: "/get-involved", label: "Get Involved" },
];

import LOGO from "../media/logo.png";
import IGEO_LOGO from "../media/igeo-logo.png";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="International Geoscience Youth Movement">
      <img
        src={LOGO.src}
        alt="IGYM Logo"
        class="brand-logo"
      />

      <span class="brand-text">
        I-GYM
        <span class="brand-sub">
          International Geoscience Youth Movement
        </span>
      </span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />

    <label for="nav-toggle" class="nav-toggle" aria-label="Toggle menu">
      <span></span>
    </label>

    <nav aria-label="Primary">
      <ul class="nav-links">
        {links.map((l) => {
          const href = l.href.replace(/\/$/, "") || "/";
          const isCurrent = current === href;

          return (
            <li>
              <a
                href={l.href}
                aria-current={isCurrent ? "page" : undefined}
              >
                {l.label}
              </a>
            </li>
          );
        })}
      </ul>

      <!-- Mobile IGEO Badge -->
      <div class="partner-badge partner-badge-mobile">
        <span class="partner-label">Supported by</span>
        <a 
          href="https://www.igeoscied.org/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="partner-link"
          aria-label="Supported by International GeoScience Education Organisation"
        >
          <img 
            src={IGEO_LOGO.src} 
            alt="International GeoScience Education Organisation Logo" 
            class="partner-logo-xl" 
          />
        </a>
      </div>
    </nav>

    <!-- Desktop IGEO Badge -->
    <div class="partner-badge partner-badge-desktop">
      <span class="partner-label">Supported by</span>
      <a 
        href="https://www.igeoscied.org/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="partner-link"
        aria-label="Supported by International GeoScience Education Organisation"
      >
        <img 
          src={IGEO_LOGO.src} 
          alt="International GeoScience Education Organisation Logo" 
          class="partner-logo-xl" 
        />
      </a>
    </div>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(234, 225, 200, 0.95);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line);
    width: 100%;
  }

  .nav-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.8rem; /* Balanced, comfortable padding */
    max-width: 1400px;
    margin: 0 auto;
    padding-inline: 2rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
  }

  .brand-logo {
    height: 52px;
    width: auto;
    object-fit: contain;
    flex-shrink: 0;
    display: block;
  }

  .brand-text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    line-height: 1.1;
    display: flex;
    flex-direction: column;
  }

  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 400;
  }

  .nav-links {
    list-style: none;
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--ink-soft);
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current="page"] {
    color: var(--rust);
    border-color: var(--rust);
  }

  /* Partner Badge Layout */
  .partner-badge {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-shrink: 0;
  }

  .partner-badge-desktop {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }

  .partner-badge-mobile {
    display: none;
  }

  .partner-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    line-height: 1.2;
    white-space: nowrap;
  }

  .partner-link {
    display: flex;
    align-items: center;
    transition: opacity 0.2s ease;
  }

  .partner-link:hover {
    opacity: 0.85;
  }

  /* Retains large logo scale (100px) with balanced vertical pulling */
  .partner-logo-xl {
    height: 100px;
    width: auto;
    object-fit: contain;
    display: block;
    margin-block: -20px;
  }

  .nav-toggle-input {
    display: none;
  }

  .nav-toggle {
    display: none;
    width: 28px;
    height: 22px;
    position: relative;
    cursor: pointer;
  }

  .nav-toggle span,
  .nav-toggle span::before,
  .nav-toggle span::after {
    content: "";
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--ink);
    transition: transform 0.2s ease;
  }

  .nav-toggle span {
    top: 10px;
  }

  .nav-toggle span::before {
    top: -8px;
  }

  .nav-toggle span::after {
    top: 8px;
  }

  @media (max-width: 1024px) {
    .partner-badge-desktop {
      display: none;
    }

    .partner-badge-mobile {
      display: flex;
      padding: 1rem 1.25rem;
      border-top: 1px solid var(--line);
      margin-top: 0.5rem;
      background: rgba(0, 0, 0, 0.02);
    }

    .partner-logo-xl {
      height: 70px;
      margin-block: 0;
    }

    .nav-inner {
      padding-block: 0.7rem;
    }

    .brand-logo {
      height: 44px;
    }

    .brand-sub {
      display: none;
    }

    .nav-toggle {
      display: block;
    }

    nav[aria-label="Primary"] {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }

    .nav-links {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 0;
    }

    .nav-links li a {
      display: block;
      padding: 0.85rem 1.25rem;
      border-bottom: 1px solid var(--line);
    }

    .nav-toggle-input:checked ~ nav[aria-label="Primary"] {
      max-height: 600px;
    }
  }
</style>