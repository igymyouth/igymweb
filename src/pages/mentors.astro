  <!-- =========================
       CLOSING
       ========================= -->

  <section class="closing">
    <div class="container closing-inner">

      <p class="eyebrow">Learning beyond the classroom</p>

      <h2>Experience meets curiosity.</h2>

      <p>
        Our mentors help turn questions into exploration, ideas into action,
        and young curiosity into meaningful scientific learning.
      </p>

    </div>
  </section>

</Layout>


<style>

  /* =========================
     HERO
     ========================= */

  .intro {
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .intro-inner {
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
  }

  .intro-inner h1 {
    max-width: 1050px;
    margin-top: 0.4rem;
    margin-bottom: 2rem;
  }

  .intro-inner .lede {
    max-width: 800px;
    font-size: var(--step-1);
    line-height: 1.55;
  }


  /* =========================
     MENTOR SECTION
     ========================= */

  .mentor {
    padding-block: clamp(4rem, 7vw, 6rem);
    background: var(--paper);
  }

  .mentor-alt {
    background: var(--stone);
  }

  .mentor-container {
    max-width: 1300px;
    margin-inline: auto;
  }


  /* =========================
     MENTOR HEADING
     ========================= */

  .mentor-heading {
    margin-bottom: 2.75rem;
  }

  .mentor-heading h2 {
    margin-top: 0.25rem;
    margin-bottom: 0.4rem;
  }

  .mentor-role {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--ochre);
  }


  /* =========================
     IMAGE + BIOGRAPHY
     ========================= */

  .mentor-bio-layout {
    display: grid;

    /*
      Image width | Biography width
    */
    grid-template-columns: 500px minmax(0, 1fr);

    gap: clamp(3rem, 5vw, 5rem);

    /*
      IMPORTANT:
      This centers the image against
      the biography only.
    */
    align-items: center;

    width: 100%;
  }


  /* =========================
     IMAGE
     ========================= */

  .mentor-photo {
    width: 100%;
    display: flex;
    align-items: center;
  }

  .mentor-photo img {
    width: 100%;
    height: auto;
    display: block;

    /*
      Do NOT crop the photograph.
    */
    object-fit: contain;

    border-radius: var(--radius);
  }


  /* =========================
     BIOGRAPHY
     ========================= */

  .mentor-bio {
    width: 100%;
    max-width: 760px;
  }

  .mentor-bio p {
    margin-top: 0;
    margin-bottom: 1.2rem;

    line-height: 1.55;

    text-align: justify;
  }

  .mentor-bio p:last-child {
    margin-bottom: 0;
  }


  /* =========================
     ALTERNATE LAYOUT
     ========================= */

  /*
    Default:

    IMAGE | BIO

    mentor-reverse:

    BIO | IMAGE
  */

  .mentor-reverse .mentor-bio-layout {
    grid-template-columns: minmax(0, 1fr) 500px;
  }

  .mentor-reverse .mentor-photo {
    order: 2;
  }

  .mentor-reverse .mentor-bio {
    order: 1;
  }


  /* =========================
     CLOSING
     ========================= */

  .closing {
    padding-block: clamp(4rem, 7vw, 6rem);
    background: var(--paper);
  }

  .closing-inner {
    max-width: 700px;
    margin-inline: auto;
    text-align: center;
  }

  .closing-inner h2 {
    margin-top: 0.25rem;
    margin-bottom: 1rem;
  }

  .closing-inner p:last-child {
    line-height: 1.6;
  }


  /* =========================
     LAPTOP
     ========================= */

  @media (max-width: 1100px) {

    .mentor-container {
      max-width: 900px;
    }

    .mentor-bio-layout {
      grid-template-columns: 400px minmax(0, 1fr);
      gap: 3rem;
    }

    .mentor-reverse .mentor-bio-layout {
      grid-template-columns: minmax(0, 1fr) 400px;
    }

  }


  /* =========================
     TABLET
     ========================= */

  @media (max-width: 850px) {

    .intro-inner {
      max-width: 100%;
    }

    .intro-inner h1 {
      max-width: 800px;
    }

    .mentor-bio-layout,
    .mentor-reverse .mentor-bio-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    /*
      On mobile, always show image first.
    */
    .mentor-reverse .mentor-photo {
      order: 1;
    }

    .mentor-reverse .mentor-bio {
      order: 2;
    }

    .mentor-photo {
      max-width: 550px;
    }

    .mentor-bio {
      max-width: 100%;
    }

  }


  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 600px) {

    .intro {
      padding-block: 3.5rem;
    }

    .mentor {
      padding-block: 3.5rem;
    }

    .mentor-heading {
      margin-bottom: 2rem;
    }

    .mentor-role {
      font-size: 0.72rem;
    }

    .mentor-bio p {
      text-align: left;
    }

    .closing {
      padding-block: 3.5rem;
    }

  }

</style>