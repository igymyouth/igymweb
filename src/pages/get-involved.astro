---
import Layout from "../layouts/Layout.astro";
import FaultLine from "../components/FaultLine.astro";

const paths = [
  {
    id: "01",
    title: "Join a chapter",
    who: "Students aged 14–25",
    copy: "Find an active chapter near you and start turning up to workshops, mapping days, and olympiad prep sessions.",
    cta: { label: "Find a chapter", href: "#chapter-map" },
  },
  {
    id: "02",
    title: "Start a chapter",
    who: "Students at a school or university without one",
    copy: "We'll send a starter kit — curriculum, olympiad prep material, and a mentor from the nearest regional coordinator.",
    cta: { label: "Request a starter kit", href: "#signup" },
  },
  {
    id: "03",
    title: "Volunteer as a coordinator",
    who: "Alumni, mentors, and teachers",
    copy: "Regional coordinators need help running selection trials, translating materials, and mentoring new chapter leads.",
    cta: { label: "See open roles", href: "#signup" },
  },
  {
    id: "04",
    title: "Partner or support",
    who: "Institutions, olympiad committees, and donors",
    copy: "Sponsor a field trip, host a training, or help cover instruments and travel for chapters that need it most.",
    cta: { label: "Talk to us", href: "mailto:partners@igym.org" },
  },
];
---
<Layout title="Get Involved" description="Join or start an IGYM chapter, volunteer as a regional coordinator, or partner with the movement.">
  <section class="intro">
    <div class="container">
      <p class="eyebrow">Get Involved</p>
      <h1>Pick your layer.</h1>
      <p class="lede">
        Every part of IGYM runs on volunteers who were once exactly where you are now. Here's where
        most people start.
      </p>
    </div>
  </section>

  <FaultLine from="var(--stone)" to="var(--paper)" />

  <section class="paths" style="background: var(--paper);">
    <div class="container">
      <div class="path-grid">
        {paths.map((p) => (
          <div class="card path-card">
            <span class="path-id">{p.id}</span>
            <h3>{p.title}</h3>
            <p class="path-who">{p.who}</p>
            <p>{p.copy}</p>
            <a href={p.cta.href} class="btn btn-ghost">{p.cta.label}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FaultLine from="var(--paper)" to="var(--stone)" />

  <section class="signup" id="signup">
    <div class="container signup-inner">
      <div class="signup-copy">
        <p class="eyebrow">Tell us where to send the kit</p>
        <h2>Get the starter kit, mentor match, or volunteer form.</h2>
        <p>
          Fill this in and the right regional coordinator will follow up — usually within a week.
          No chapter yet? That's the point of this form.
        </p>
      </div>

      <form class="card signup-form" id="signup-form" novalidate>
        <div class="field">
          <label for="name">Full name</label>
          <input id="name" name="name" type="text" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required />
        </div>
        <div class="field">
          <label for="location">City / country</label>
          <input id="location" name="location" type="text" required />
        </div>
        <div class="field">
          <label for="interest">I'm interested in</label>
          <select id="interest" name="interest" required>
            <option value="">Select one</option>
            <option>Joining an existing chapter</option>
            <option>Starting a new chapter</option>
            <option>Volunteering as a coordinator</option>
            <option>Partnering or supporting IGYM</option>
          </select>
        </div>
        <div class="field">
          <label for="message">A little about you</label>
          <textarea id="message" name="message" rows="4" placeholder="Your school or university, your olympiad background if any, and what you're hoping to do."></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send</button>
        <p class="form-status" role="status" aria-live="polite" hidden></p>
      </form>
    </div>
  </section>



 

  <script>
    const form = document.getElementById("signup-form");
    const statusEl = form.querySelector(".form-status");
    const submitBtn = form.querySelector('button[type="submit"]');

    // Attached first and unconditionally — guarantees the page can
    // never reload or change URL on submit, even if Firebase fails to load.
    form.addEventListener("submit", handleSubmit);

    function showStatus(message, type) {
      statusEl.textContent = message;
      statusEl.className = `form-status ${type}`;
      statusEl.hidden = false;
    }

    function clearFieldErrors() {
      form.querySelectorAll(".field").forEach((f) => f.classList.remove("field-error"));
    }

    function validate(data) {
      const errors = [];
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      if (!data.name || data.name.trim().length < 2) {
        errors.push({ field: "name", message: "Please enter your full name." });
      }
      if (!data.email || !emailRegex.test(data.email.trim())) {
        errors.push({ field: "email", message: "Please enter a valid email address." });
      }
      if (!data.location || data.location.trim().length < 2) {
        errors.push({ field: "location", message: "Please enter your city or country." });
      }
      if (!data.interest) {
        errors.push({ field: "interest", message: "Please select what you're interested in." });
      }
      if (data.message && data.message.length > 1000) {
        errors.push({ field: "message", message: "Please keep your message under 1000 characters." });
      }
      return errors;
    }

    async function handleSubmit(e) {
      e.preventDefault();
      statusEl.hidden = true;
      clearFieldErrors();

      const data = {
        name: form.name.value.trim(),
        email: form.email.value.trim(),
        location: form.location.value.trim(),
        interest: form.interest.value,
        message: form.message.value.trim(),
      };

      const errors = validate(data);
      if (errors.length) {
        errors.forEach((err) => {
          const fieldEl = form.querySelector(`#${err.field}`)?.closest(".field");
          if (fieldEl) fieldEl.classList.add("field-error");
        });
        showStatus(errors.map((e) => e.message).join(" "), "error");
        return;
      }

      submitBtn.disabled = true;
      const originalLabel = submitBtn.textContent;
      submitBtn.textContent = "Sending...";

      try {
        const { db } = await import("../lib/firebase.js");
        const { collection, addDoc, serverTimestamp } = await import("firebase/firestore");

        await addDoc(collection(db, "Applications"), {
          ...data,
          timestamp: serverTimestamp(),
        });

        showStatus("Thanks! We've received your details — a coordinator will follow up soon.", "success");
        form.reset();
      } catch (err) {
        console.error("Firestore write failed:", err);
        showStatus("Something went wrong sending your details. Please try again, or email hello@igym.org directly.", "error");
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    }
  </script>
</Layout>

<style>
  .intro { padding-block: clamp(3rem, 7vw, 5rem); }
  .intro .lede { font-size: var(--step-1); max-width: 56ch; }

  .paths { padding-block: clamp(3rem, 7vw, 5rem); }
  .path-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .path-card { position: relative; }
  .path-id {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ochre);
    display: block;
    margin-bottom: 0.75rem;
  }
  .path-who {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--rust);
    margin-bottom: 0.75rem;
  }
  .path-card .btn { margin-top: 0.5rem; }

  .signup { padding-block: clamp(3rem, 7vw, 5rem); }
  .signup-inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 3rem;
    align-items: start;
  }
  .signup-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .field label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }
  .field input,
  .field select,
  .field textarea {
    font-family: var(--font-body);
    font-size: 0.95rem;
    padding: 0.7em 0.85em;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--stone);
    color: var(--ink);
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--rust);
    outline-offset: 1px;
  }
  .field-error input,
  .field-error select,
  .field-error textarea {
    border-color: var(--rust);
  }
  .signup-form .btn { align-self: flex-start; }

  .form-status {
    font-size: 0.85rem;
    padding: 0.75em 1em;
    border-radius: var(--radius);
    margin: 0;
  }
  .form-status.success {
    background: color-mix(in srgb, green 15%, transparent);
    color: #2e7d32;
    border: 1px solid #2e7d32;
  }
  .form-status.error {
    background: color-mix(in srgb, var(--rust) 15%, transparent);
    color: var(--rust);
    border: 1px solid var(--rust);
  }

  .map { padding-block: clamp(3rem, 7vw, 5rem); }
  .map-inner p { max-width: 60ch; }
  .map-inner a { color: var(--ochre); }

  @media (max-width: 900px) {
    .path-grid { grid-template-columns: 1fr; }
    .signup-inner { grid-template-columns: 1fr; }
  }
</style>