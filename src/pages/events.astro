---
import Layout from "../layouts/Layout.astro";
import FaultLine from "../components/FaultLine.astro";

const upcoming = [
];

const past = [
  { date: "July 2026", title: "I-GYM'26", location: "Bengaluru, India" },
  { date: "July 2025", title: "I-GYM'25", location: "Bengaluru, India" }
];

const typeColor: Record<string, string> = {
  Fieldwork: "var(--rust)",
  Olympiad: "var(--verdigris)",
  Workshop: "var(--ochre)",
  Assembly: "var(--slate)",
};
---
<Layout title="Events" description="IGYM's calendar of mapping camps, olympiad selection trials, workshops, and the annual assembly.">
  <section class="intro">
    <div class="container">
      <p class="eyebrow">Events</p>
      <h1>Next on the calendar.</h1>
      <p class="lede">
       Explore workshops, outreach programs, field excursions, webinars, chapter activities, expert talks, and international collaborations that bring young Earth scientists together to learn, lead, and inspire change.
      </p>
    </div>
  </section>

  <FaultLine from="var(--stone)" to="var(--paper)" />

  <!-- <section class="upcoming" style="background: var(--paper);">
    <div class="container">
      <p class="eyebrow">Upcoming</p>
      <ul class="event-list">
        {upcoming.map((e) => (
          <li class="event-row">
            <div class="event-date">{e.date}</div>
            <div class="event-body">
              <div class="event-head">
                <h3>{e.title}</h3>
                <span class="tag" style={{ color: typeColor[e.type], borderColor: typeColor[e.type] }}>{e.type}</span>
              </div>
              <p class="event-location">{e.location}</p>
              <p>{e.copy}</p>
            </div>
            <a href="/get-involved" class="btn btn-ghost event-cta">Register interest</a>
          </li>
        ))}
      </ul>
    </div>
  </section> -->
  <section class="upcoming" style="background: var(--paper);">
  <div class="container">
    <p class="eyebrow">Upcoming</p>
    {upcoming.length > 0 ? (
      <ul class="event-list">
        {upcoming.map((e) => (
          <li class="event-row">
            <div class="event-date">{e.date}</div>
            <div class="event-body">
              <div class="event-head">
                <h3>{e.title}</h3>
                <span class="tag" style={{ color: typeColor[e.type], borderColor: typeColor[e.type] }}>{e.type}</span>
              </div>
              <p class="event-location">{e.location}</p>
              <p>{e.copy}</p>
            </div>
            <a href="/get-involved" class="btn btn-ghost event-cta">Register interest</a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty-state">
        <h3>More events coming soon.</h3>
        <p>We're finalizing the calendar for upcoming workshops, seminars & many more. Check back soon, or get involved to be notified first.</p>
        <a href="/get-involved" class="btn btn-ghost">Get notified</a>
      </div>
    )}
  </div>
</section>

  <FaultLine from="var(--paper)" to="var(--slate)" />

  <section class="past dark">
    <div class="container">
      <p class="eyebrow">Past highlights</p>
      <h2>Where we've been.</h2>
      <ul class="past-list">
        {past.map((e) => (
          <li>
            <span class="past-date">{e.date}</span>
            <span class="past-title">{e.title}</span>
            <span class="past-location">{e.location}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FaultLine from="var(--slate)" to="var(--stone)" flip />

  <section class="cta">
    <div class="container cta-inner">
      <div>
        <p class="eyebrow">Take the first step.</p>
        <h2></h2>
        <p>Join I-GYM to participate in workshops, field trips, outreach initiatives, leadership programs, and a growing international community of young Earth leaders.</p>
      </div>
      <a href="/get-involved" class="btn btn-primary">Get Involved</a>
    </div>
  </section>
</Layout>

<style>
  .empty-state {
  text-align: center;
  padding-block: clamp(2.5rem, 6vw, 4rem);
  max-width: 48ch;
  margin: 0 auto;
}
.empty-state h3 {
  margin-bottom: 0.75rem;
}
.empty-state p {
  color: var(--ink-soft);
  margin-bottom: 1.5rem;
}
  .intro { padding-block: clamp(3rem, 7vw, 5rem); }
  .intro .lede { font-size: var(--step-1); max-width: 58ch; }

  .upcoming { padding-block: clamp(3rem, 7vw, 5rem); }
  .event-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .event-row {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    gap: 1.75rem;
    align-items: start;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .event-row:last-child { border-bottom: 1px solid var(--line); }
  .event-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--rust);
    padding-top: 0.3rem;
  }
  .event-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .event-head h3 { margin: 0; font-size: var(--step-1); }
  .event-location {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-soft);
    margin: 0.35rem 0 0.6rem;
  }
  .event-cta { align-self: center; white-space: nowrap; }

  .past { padding-block: clamp(3rem, 7vw, 5rem); }
  .past-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .past-list li {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    gap: 1.5rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line-dark);
    font-size: 0.92rem;
  }
  .past-list li:last-child { border-bottom: 1px solid var(--line-dark); }
  .past-date { font-family: var(--font-mono); color: var(--ochre); }
  .past-location { color: rgba(234, 225, 200, 0.6); font-family: var(--font-mono); font-size: 0.82rem; }

  .cta { padding-block: clamp(3rem, 7vw, 5rem); }
  .cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .cta-inner > div:first-child { max-width: 50ch; }
  .cta-inner h2 { margin-bottom: 0.5rem; }

  @media (max-width: 780px) {
    .event-row { grid-template-columns: 1fr; gap: 0.5rem; }
    .event-cta { justify-self: start; }
    .past-list li { grid-template-columns: 80px 1fr; }
    .past-location { display: none; }
  }
</style>
