---
import Layout from "../layouts/Layout.astro";
import CoreSample from "../components/CoreSample.astro";
import Contours from "../components/Contours.astro";
import FaultLine from "../components/FaultLine.astro";
import "maplibre-gl/dist/maplibre-gl.css";
import 'swiper/css';
import 'swiper/css/pagination';
import 'swiper/css/navigation';
import LOGO from "../media/logo.png"
import img1 from "../media/img1.jpeg"
import img2 from "../media/img2.jpeg"
import img3 from "../media/img3.jpeg"
import img4 from "../media/img4.jpeg"
import img5 from "../media/img5.jpeg"
import img6 from "../media/img6.jpeg"
import img7 from "../media/img7.jpeg"
import img8 from "../media/img8.jpeg"

// ---- TOGGLE THIS ----
// true  = show the "Inaugurate" splash screen (use this for the ceremony)
// false = skip straight to the normal homepage (use this while developing)
const SHOW_INAUGURATION = false;
// ----------------------

const log = [
  { k: "Founded", v: "2023" },
  { k: "Launched", v: "August 2024" },
  { k: "Members", v: "60+ from 19 different countries worldwide" },
  { k: "Chapters", v: "19" },
];

const logImages = [
  { src: img1.src},
  { src: img2.src},
  { src: img3.src},
  { src: img4.src},
  { src: img5.src},
  { src: img6.src},
  { src: img7.src},
  { src: img8.src},
];

import { db } from "../lib/firebase.js";
import { collection, getDocs } from "firebase/firestore";

const snapshot = await getDocs(collection(db, "Chapters"));
const chapterMarkers = snapshot.docs.map((doc) => {
  const data = doc.data();
  return {
    name: data.name,
    members: data.members,
    lat: data.lat,
    lng: data.lng,
  };
});
---
<Layout title="Home" description="IGYM is the International Geoscience Youth Movement — student chapters, IGEO olympiad training, and youth advocacy for earth science, in 46 countries.">

  {SHOW_INAUGURATION && (
    <div id="inaugurate-overlay">
      <div class="stage-content">
        <img src={LOGO.src} alt="IGYM Logo" class="stage-logo" />
        <p class="eyebrow">International Geoscience Youth Movement</p>
        <button id="inaugurate-btn" class="btn btn-primary">Inaugurate</button>
      </div>
    </div>

    <canvas id="confetti-canvas"></canvas>
    <audio
      id="inaugurate-sound"
      src="https://assets.mixkit.co/active_storage/sfx/2013/2013-preview.mp3"
      preload="auto"
    ></audio>
  )}

  <div id="site-content" hidden={SHOW_INAUGURATION}>
    <section class="hero">
      <Contours opacity={0.09} />
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow--nolinedash"> I-GYM — International Geoscience Youth Movement</p>
          <h1>We're the Youth<br /> Leaders of Earth Science Education</h1>
          <p class="hero-lede">
I-GYM program was launched during IESO 2024, and since then, we have been committed to driving meaningful change in the growth of Earth Science Education System (ESE) through inquiry based learning. We are proud to welcome many more passionate young leaders who share our vision of transforming the future of geosciences.        </p>
          <div class="hero-actions">
            <a href="/events" class="btn btn-ghost">See upcoming events</a>
          </div>
        </div>
        <div class="hero-visual">
          <div class="core" role="img" aria-label="International Geoscience Youth Movement Logo">
            <img src={LOGO.src} alt="IGYM Logo" class="core-logo" />
          </div>
        </div>
      </div>
    </section>

    <FaultLine from="var(--stone)" to="var(--paper)" />

    <section class="pillars" style="background: var(--paper);">
      <div class="container">
        <p class="eyebrow">Our Presence Around The World</p>
        <h2>Where Are We Situated</h2>
        <div
          id="map"
          data-markers={JSON.stringify(chapterMarkers)}
        ></div>
      </div>
    </section>

    <FaultLine from="var(--paper)" to="var(--slate)" />

    <section class="log dark">
      <div class="container log-inner">
        <div class="log-head">
          <div class="swiper log-swiper">
            <div class="swiper-wrapper">
              {logImages.map((img) => (
                <div class="swiper-slide">
                  <img src={img.src} alt="IGYM gallery photo" />
                </div>
              ))}
            </div>
            <div class="swiper-pagination"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
          </div>
        </div>

        <dl class="log-list">
          <p style="font-family: var(--font-mono);
      font-size: 1.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--ochre);">Milestones That Matter</p>
          {log.map((row) => (
            <div class="log-row">
              <dt>{row.k}</dt>
              <dd>{row.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <FaultLine from="var(--slate)" to="var(--stone)" flip />

    <section class="preview">
      <div class="container preview-inner">
        <div>
          <p class="eyebrow">Youth leaders</p>
          <h2>Run by students, region by region.</h2>
          <p>Meet the enthusiatic Youth Leaders coordinating chapters from across the globe</p>
          <a href="/youth-leaders" class="btn btn-ghost">Meet the leaders</a>
        </div>
        <div>
          <p class="eyebrow">Upcoming</p>
          <h2>Next on the calendar.</h2>
          <p>Upcoming workshops, webinars & networking events
for the next generation of Earth science leaders. </p>
          <a href="/events" class="btn btn-ghost">View the calendar</a>
        </div>
      </div>
    </section>
  </div>

</Layout>

<style>
  #inaugurate-overlay {
    position: fixed;
    inset: 0;
    z-index: 9998;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 1s ease, visibility 1s ease;
  }
  #inaugurate-overlay.fade-out {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  #confetti-canvas {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9999;
  }

  .stage-content {
    text-align: center;
    padding: 2rem;
    transition: transform 0.6s ease, opacity 0.6s ease;
  }
  .stage-content.launched {
    transform: scale(1.08);
    opacity: 0;
  }

  .stage-logo {
    width: min(60vw, 220px);
    height: auto;
    margin-bottom: 1.5rem;
  }

  .stage-content .eyebrow {
    color: var(--ink-soft, #555);
    font-family: var(--font-mono, monospace);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    margin-bottom: 2rem;
  }

  #inaugurate-btn {
    font-size: 1.3rem;
    padding: 1em 2.5em;
    cursor: pointer;
  }

  .hero {
    position: relative;
    padding-block: clamp(3rem, 8vw, 6rem);
    overflow: hidden;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 3rem;
    align-items: center;
  }
  .hero-lede {
    font-size: var(--step-1);
    max-width: 46ch;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }
  .hero-visual {
    display: flex;
    justify-content: center;
    padding-top: 1rem;
  }

  .core {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .core-logo {
    width: min(100%, 380px);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 12px 20px rgba(27, 44, 54, 0.18));
  }
  @media (max-width: 640px) {
    .core-logo {
      width: min(100%, 240px);
    }
  }

  .log-swiper {
    --swiper-pagination-color: #fff;
    --swiper-pagination-bullet-inactive-color: #fff;
    --swiper-pagination-bullet-inactive-opacity: 0.4;
  }

  .pillars { padding-block: clamp(3rem, 7vw, 5rem); }
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .pillar-card .tag { margin-bottom: 1rem; color: var(--rust); border-color: var(--rust); }

  #map {
    height: 420px;
    width: 100%;
    margin-top: 2rem;
    border-radius: 8px;
    overflow: hidden;
    background: var(--stone);
  }

  .log { padding-block: clamp(3rem, 7vw, 5rem); }
  .log-inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 3rem;
  }

  .log-head { position: relative; min-width: 0; }
  .log-swiper .swiper-wrapper { flex-wrap: nowrap; }
  .log-swiper .swiper-slide {
    width: 100%;
    flex-shrink: 0;
    height: 100%;
  }
  .log-swiper {
    width: 100%;
    height: 360px;
    border-radius: 8px;
    overflow: hidden;
  }
  .log-swiper .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .log-swiper .swiper-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .log-swiper .swiper-button-prev,
  .log-swiper .swiper-button-next {
    color: var(--paper, #fff);
  }
  .log-swiper .swiper-pagination-bullet {
    background: var(--paper, #fff);
    opacity: 1;
  }
  .log-swiper .swiper-pagination-bullet-active {
    opacity: 1;
  }

  .log-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .log-row {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line-dark);
  }
  .log-row dt {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ochre);
  }
  .log-row dd { margin: 0; color: var(--stone); }

  .preview { padding-block: clamp(3rem, 7vw, 5rem); }
  .preview-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .cta { padding-block: clamp(2.5rem, 6vw, 4rem); }
  .cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .cta-inner h2 { margin-bottom: 0; }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-visual { order: -1; }
    .pillar-grid { grid-template-columns: 1fr; }
    .log-inner { grid-template-columns: 1fr; }
    .preview-inner { grid-template-columns: 1fr; }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay } from 'swiper/modules';
  import { Map, Marker, Popup, NavigationControl } from "maplibre-gl";

  const btn = document.getElementById("inaugurate-btn");
  const overlay = document.getElementById("inaugurate-overlay");
  const stageContent = document.querySelector(".stage-content");
  const siteContent = document.getElementById("site-content");
  const canvas = document.getElementById("confetti-canvas") as HTMLCanvasElement | null;
  const sound = document.getElementById("inaugurate-sound") as HTMLAudioElement | null;

  // ---- Confetti (only set up if the overlay exists on this page) ----
  let ctx: CanvasRenderingContext2D | null = null;
  let particles: any[] = [];
  let animationId: number | null = null;

  if (canvas) {
    ctx = canvas.getContext("2d");
    function resizeCanvas() {
      canvas!.width = window.innerWidth;
      canvas!.height = window.innerHeight;
    }
    resizeCanvas();
    window.addEventListener("resize", resizeCanvas);
  }

  const colors = ["#d97b45", "#c76e3a", "#e0a840", "#3a7d6b", "#2f2a26", "#8fb8a8"];

  function createParticle() {
    return {
      x: Math.random() * canvas!.width,
      y: -20,
      size: Math.random() * 8 + 4,
      color: colors[Math.floor(Math.random() * colors.length)],
      speedY: Math.random() * 3 + 2,
      speedX: Math.random() * 4 - 2,
      rotation: Math.random() * 360,
      rotationSpeed: Math.random() * 10 - 5,
      shape: Math.random() > 0.5 ? "rect" : "circle",
    };
  }

  function animate() {
    if (!ctx || !canvas) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    particles.forEach((p) => {
      p.y += p.speedY;
      p.x += p.speedX;
      p.rotation += p.rotationSpeed;
      ctx!.save();
      ctx!.translate(p.x, p.y);
      ctx!.rotate((p.rotation * Math.PI) / 180);
      ctx!.fillStyle = p.color;
      if (p.shape === "rect") {
        ctx!.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.6);
      } else {
        ctx!.beginPath();
        ctx!.arc(0, 0, p.size / 2, 0, Math.PI * 2);
        ctx!.fill();
      }
      ctx!.restore();
    });
    particles = particles.filter((p) => p.y < canvas!.height + 30);
    if (particles.length > 0) {
      animationId = requestAnimationFrame(animate);
    } else {
      animationId = null;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    }
  }

  function launchConfetti() {
    if (!canvas) return;
    for (let i = 0; i < 220; i++) particles.push(createParticle());
    if (!animationId) animate();
    let bursts = 0;
    const interval = setInterval(() => {
      for (let i = 0; i < 70; i++) particles.push(createParticle());
      bursts++;
      if (bursts > 7) clearInterval(interval);
    }, 300);
  }

  // ---- Site init: map + carousel ----
  function initSite() {
    new Swiper('.log-swiper', {
      modules: [Navigation, Pagination, Autoplay],
      loop: true,
      roundLengths: true,
      autoplay: { delay: 4000, disableOnInteraction: false },
      pagination: { el: '.swiper-pagination', clickable: true },
      navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
    });

    const mapEl = document.getElementById("map");
    if (mapEl instanceof HTMLElement) {
      const raw = mapEl.getAttribute("data-markers") ?? "[]";
      const decoded = raw
        .replaceAll("&quot;", '"')
        .replaceAll("&#34;", '"')
        .replaceAll("&amp;", "&");

      const chapters = JSON.parse(decoded) as Array<{
        name: string;
        members: number;
        lat: number;
        lng: number;
      }>;

      const map = new Map({
        container: mapEl,
        style: "https://tiles.openfreemap.org/styles/liberty",
        center: [20, 15],
        zoom: 1,
        minZoom: 1,
      });

      map.addControl(new NavigationControl({ showCompass: false }), "top-right");

      chapters.forEach((chapter) => {
        const popup = new Popup({ offset: 16 }).setHTML(
          `<strong>${chapter.name}</strong><br>${chapter.members} ${chapter.members === 1 ? "member" : "members"}`
        );
        new Marker({ color: "#b5563a" })
          .setLngLat([chapter.lng, chapter.lat])
          .setPopup(popup)
          .addTo(map);
      });
    }
  }

  // ---- Wire the inaugurate button, if present ----
  if (btn && overlay) {
    btn.addEventListener("click", () => {
      stageContent?.classList.add("launched");
      launchConfetti();
      sound?.play().catch(() => {});

      setTimeout(() => {
        overlay.classList.add("fade-out");
      }, 200);

      siteContent!.hidden = false;

      setTimeout(() => {
        overlay.remove();
        initSite();
      }, 1200);
    });
  } else {
    // No overlay on this page (dev mode) — init the site immediately.
    initSite();
  }
</script>
