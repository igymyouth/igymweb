---
import Layout from "../layouts/Layout.astro";
import CoreSample from "../components/CoreSample.astro";
import Contours from "../components/Contours.astro";
import FaultLine from "../components/FaultLine.astro";
import "maplibre-gl/dist/maplibre-gl.css";
import 'swiper/css';
import 'swiper/css/pagination';
import 'swiper/css/navigation';
import LOGO from "../media/logo.png"
import img1 from "../media/img1.jpeg"
import img2 from "../media/img2.jpeg"
import img3 from "../media/img3.jpeg"
import img4 from "../media/img4.jpeg"
import img5 from "../media/img5.jpeg"
import img6 from "../media/img6.jpeg"
import img7 from "../media/img7.jpeg"
import img8 from "../media/img8.jpeg"

const log = [
  { k: "Founded", v: "2023" },
  { k: "Launched", v: "August 2024" },
  { k: "Members", v: "60+ from 19 different countries worldwide" },
  { k: "Chapters", v: "19" },
];

const logImages = [
  { src: img1.src},
  { src: img2.src},
  { src: img3.src},
  { src: img4.src},
  { src: img5.src},
  { src: img6.src},
  { src: img7.src},
  { src: img8.src},
];

const reflections = [
  {
    quote: "The journey began by cultivating the habit of asking questions, encouraging us to think critically and explore the world around us.",
    author: "Aswatha Biju",
    role: "I-GYM 2025 Participant",
    country: "India"
  },
  {
    quote: "I-GYM 2026 was not only an educational experience but also a journey of inspiration, teamwork, and personal growth — a wonderful opportunity to learn, connect, and grow.",
    author: "Sarasi",
    role: "I-GYM 2026 Participant",
    country: "Sri Lanka"
  },
  {
    quote: "As a law student, this experience reminded me that Earth Science is not limited to scientists alone.",
    author: "Archana Gunawardhana",
    role: "I-GYM 2026 Participant",
    country: "Sri Lanka"
  },
  {
    quote: "I-GYM provided a seamless bridge between theoretical geology and real-world application. This interactive methodology significantly enhanced our critical thinking, data interpretation, and scientific inquiry skills.",
    author: "Apamnidhi Pandey",
    role: "I-GYM 2026 Participant",
    country: "India"
  },
  {
    quote: "Interacting with students from different regions and countries broadened my perspective.",
    author: "Sanwariya Purbey",
    role: "I-GYM 2026 Participant",
    country: "India"
  },
  {
    quote: "The emphasis on developing real-world skills, critical thinking, and experiential learning gave us a fresh perspective on geology and its applications.",
    author: "Hirini",
    role: "I-GYM 2026 Participant",
    country: "Sri Lanka"
  },
  {
    quote: "It never felt like a typical class. We were actively encouraged to ask big questions, think critically about complex Earth processes, and explore real-world challenges.",
    author: "Thenuki",
    role: "I-GYM 2026 Participant",
    country: "Sri Lanka"
  },
  {
    quote: "We learned a great deal about how geosciences are perceived in other countries and how we can all collectively work together to contribute to the cause.",
    author: "Arush",
    role: "I-GYM 2026 Participant",
    country: "India"
  },
  {
    quote: "The study of the Earth is also a study of humility, of learning our place within something vast and unhurried.",
    author: "Kyishong Bharali Das",
    role: "I-GYM 2026 Participant",
    country: "India"
  }
];

import { db } from "../lib/firebase.js";
import { collection, getDocs } from "firebase/firestore";

const snapshot = await getDocs(collection(db, "Chapters"));
const chapterMarkers = snapshot.docs.map((doc) => {
  const data = doc.data();
  return {
    name: data.name,
    members: data.members,
    lat: data.lat,
    lng: data.lng,
  };
});
---
<Layout title="Home" description="IGYM is the International Geoscience Youth Movement — student chapters, IGEO olympiad training, and youth advocacy for earth science, in 46 countries.">

  <div id="site-content">
    <section class="hero">
      <Contours opacity={0.09} />
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow--nolinedash"> I-GYM — International Geoscience Youth Movement</p>
          <h1>We're the Youth<br /> Leaders of Earth Science Education</h1>
          <p class="hero-lede">
            I-GYM program was launched during IESO 2024, and since then, we have been committed to driving meaningful change in the growth of Earth Science Education System (ESE) through inquiry based learning. We are proud to welcome many more passionate young leaders who share our vision of transforming the future of geosciences.
          </p>
          <div class="hero-actions">
            <a href="/events" class="btn btn-ghost">See upcoming events</a>
          </div>
        </div>
        <div class="hero-visual">
          <div class="core" role="img" aria-label="International Geoscience Youth Movement Logo">
            <img src={LOGO.src} alt="IGYM Logo" class="core-logo" />
          </div>
        </div>
      </div>
    </section>

    <FaultLine from="var(--stone)" to="var(--paper)" />

    <section class="pillars" style="background: var(--paper);">
      <div class="container">
        <p class="eyebrow">Our Presence Around The World</p>
        <h2>Where Are We Situated</h2>
        <div
          id="map"
          data-markers={JSON.stringify(chapterMarkers)}
        ></div>
      </div>
    </section>

    <FaultLine from="var(--paper)" to="var(--slate)" />

    <section class="log dark">
      <div class="container log-inner">
        <div class="log-head">
          <div class="swiper log-swiper">
            <div class="swiper-wrapper">
              {logImages.map((img) => (
                <div class="swiper-slide">
                  <img src={img.src} alt="IGYM gallery photo" />
                </div>
              ))}
            </div>
            <div class="swiper-pagination"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
          </div>
        </div>

        <dl class="log-list">
          <p style="font-family: var(--font-mono); font-size: 1.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ochre);">
            Milestones That Matter
          </p>
          {log.map((row) => (
            <div class="log-row">
              <dt>{row.k}</dt>
              <dd>{row.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <FaultLine from="var(--slate)" to="var(--paper)" flip />

    <section class="reflections">
      <div class="container">
        <div class="reflections-header">
          <p class="eyebrow">Voices of IGYM</p>
          <h2>Participant Reflections</h2>
        </div>

        <div class="reflections-wrapper">
          <div class="swiper reflections-swiper">
            <div class="swiper-wrapper">
              {reflections.map((item) => (
                <div class="swiper-slide">
                  <blockquote class="journal-card">
                    <span class="quote-mark" aria-hidden="true">“</span>
                    <p class="reflection-text">{item.quote}</p>
                    <cite class="reflection-author">
                      <span class="author-name">{item.author}</span>
                      <span class="author-meta">{item.role} &mdash; {item.country}</span>
                    </cite>
                  </blockquote>
                </div>
              ))}
            </div>
            <div class="swiper-pagination"></div>
          </div>
          <div class="swiper-button-prev reflections-prev"></div>
          <div class="swiper-button-next reflections-next"></div>
        </div>
      </div>
    </section>

    <FaultLine from="var(--paper)" to="var(--stone)" />

    <section class="preview">
      <div class="container preview-inner">
        <div>
          <p class="eyebrow">Youth leaders</p>
          <h2>Run by students, region by region.</h2>
          <p>Meet the enthusiatic Youth Leaders coordinating chapters from across the globe</p>
          <a href="/youth-leaders" class="btn btn-ghost">Meet the leaders</a>
        </div>
        <div>
          <p class="eyebrow">Upcoming</p>
          <h2>Next on the calendar.</h2>
          <p>Upcoming workshops, webinars & networking events for the next generation of Earth science leaders.</p>
          <a href="/events" class="btn btn-ghost">View the calendar</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 8vw, 6rem);
    overflow: hidden;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 3rem;
    align-items: center;
  }
  .hero-lede {
    font-size: var(--step-1);
    max-width: 46ch;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }
  .hero-visual {
    display: flex;
    justify-content: center;
    padding-top: 1rem;
  }

  .core {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .core-logo {
    width: min(100%, 380px);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 12px 20px rgba(27, 44, 54, 0.18));
  }
  @media (max-width: 640px) {
    .core-logo {
      width: min(100%, 240px);
    }
  }

  .log-swiper {
    --swiper-pagination-color: #fff;
    --swiper-pagination-bullet-inactive-color: #fff;
    --swiper-pagination-bullet-inactive-opacity: 0.4;
  }

  .pillars { padding-block: clamp(3rem, 7vw, 5rem); }

  #map {
    height: 420px;
    width: 100%;
    margin-top: 2rem;
    border-radius: 8px;
    overflow: hidden;
    background: var(--stone);
  }

  .log { padding-block: clamp(3rem, 7vw, 5rem); }
  .log-inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 3rem;
  }

  .log-head { position: relative; }
  .log-swiper .swiper-wrapper { flex-wrap: nowrap; }
  .log-swiper .swiper-slide {
    width: 100% !important;
    flex-shrink: 0;
    height: 100%;
  }
  .log-swiper {
    width: 100%;
    height: 360px;
    border-radius: 8px;
    overflow: hidden;
  }
  .log-swiper .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .log-swiper .swiper-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .log-swiper .swiper-button-prev,
  .log-swiper .swiper-button-next {
    color: var(--paper, #fff);
  }
  .log-swiper .swiper-pagination-bullet {
    background: var(--paper, #fff);
    opacity: 1;
  }

  .log-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .log-row {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line-dark);
  }
  .log-row dt {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ochre);
  }
  .log-row dd { margin: 0; color: var(--stone); }

  /* --- Reflections Section Styling --- */
  .reflections {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    background-color: var(--paper, #faf8f5);
    position: relative;
    width: 100%;
  }

  .reflections-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .reflections-wrapper {
    position: relative;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 3.5rem;
  }

  .reflections-swiper {
    width: 100%;
    overflow: hidden;
    padding-bottom: 3rem !important;
    --swiper-pagination-color: var(--rust, #b5563a);
  }

  .reflections-swiper .swiper-slide {
    height: auto;
    display: flex;
    box-sizing: border-box;
  }

  .journal-card {
    position: relative;
    background: var(--stone, #f8f6f0);
    border-radius: 12px;
    padding: clamp(2rem, 4.5vw, 3.25rem);
    box-shadow: 0 10px 28px -6px rgba(0, 0, 0, 0.06);
    box-sizing: border-box;
    width: 100%;
  }

  .quote-mark {
    position: absolute;
    top: 0.5rem;
    right: 1.5rem;
    font-size: clamp(3.5rem, 6vw, 5rem);
    line-height: 1;
    font-family: Georgia, serif;
    color: var(--rust, #b5563a);
    opacity: 0.12;
    pointer-events: none;
  }

  .reflection-text {
    font-size: clamp(0.92rem, 1.35vw, 1.02rem);
    line-height: 1.7;
    color: var(--ink, #1b2c36);
    margin-bottom: 1.75rem;
    font-weight: 400;
    text-align: left;
    position: relative;
    z-index: 1;
  }

  .reflection-author {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-style: normal;
    border-top: 1px solid var(--line, rgba(0, 0, 0, 0.1));
    padding-top: 1rem;
  }

  .author-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--ink, #1b2c36);
  }

  .author-meta {
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--rust, #b5563a);
  }

  /* --- Floating Handles --- */
  .reflections-prev,
  .reflections-next {
    color: var(--rust, #b5563a) !important;
    top: 45%;
    transform: translateY(-50%);
    width: 40px !important;
    height: 40px !important;
    background: transparent !important;
    box-shadow: none !important;
    border-radius: 50%;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), 
                color 0.25s ease,
                filter 0.25s ease;
  }

  .reflections-prev {
    left: 0.25rem;
  }

  .reflections-next {
    right: 0.25rem;
  }

  .reflections-prev::after,
  .reflections-next::after {
    font-size: 1.8rem !important;
    font-weight: 800;
  }

  .reflections-prev:hover {
    transform: translateY(-50%) translateX(-4px) scale(1.15);
    filter: drop-shadow(-2px 4px 6px rgba(181, 86, 58, 0.3));
  }

  .reflections-next:hover {
    transform: translateY(-50%) translateX(4px) scale(1.15);
    filter: drop-shadow(2px 4px 6px rgba(181, 86, 58, 0.3));
  }

  .reflections-prev:active,
  .reflections-next:active {
    transform: translateY(-50%) scale(0.95);
  }

  .preview { padding-block: clamp(3rem, 7vw, 5rem); }
  .preview-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  /* --- Responsive Breakpoints --- */
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-visual { order: -1; }
    .log-inner { grid-template-columns: 1fr; }
    .preview-inner { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .reflections-wrapper {
      padding: 0;
    }
    
    .reflections-prev,
    .reflections-next {
      top: auto;
      bottom: 0;
      transform: none;
    }

    .reflections-prev {
      left: 20%;
    }

    .reflections-next {
      right: 20%;
    }

    .reflections-prev:hover {
      transform: translateX(-3px) scale(1.15);
    }

    .reflections-next:hover {
      transform: translateX(3px) scale(1.15);
    }

    .journal-card {
      padding: 1.5rem 1.25rem;
    }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay } from 'swiper/modules';
  import { Map, Marker, Popup, NavigationControl } from "maplibre-gl";

  function initSite() {
    new Swiper('.log-swiper', {
      modules: [Navigation, Pagination, Autoplay],
      loop: true,
      autoplay: { delay: 4000, disableOnInteraction: false },
      pagination: { el: '.log-swiper .swiper-pagination', clickable: true },
      navigation: { nextEl: '.log-swiper .swiper-button-next', prevEl: '.log-swiper .swiper-button-prev' },
    });

    new Swiper('.reflections-swiper', {
      modules: [Navigation, Pagination, Autoplay],
      loop: true,
      spaceBetween: 40,
      autoplay: { delay: 8000, disableOnInteraction: false },
      pagination: { el: '.reflections-swiper .swiper-pagination', clickable: true },
      navigation: { nextEl: '.reflections-next', prevEl: '.reflections-prev' },
    });

    const mapEl = document.getElementById("map");
    if (mapEl instanceof HTMLElement) {
      const raw = mapEl.getAttribute("data-markers") ?? "[]";
      const decoded = raw
        .replaceAll("&quot;", '"')
        .replaceAll("&#34;", '"')
        .replaceAll("&amp;", "&");

      const chapters = JSON.parse(decoded) as Array<{
        name: string;
        members: number;
        lat: number;
        lng: number;
      }>;

      const map = new Map({
        container: mapEl,
        style: "https://tiles.openfreemap.org/styles/liberty",
        center: [20, 15],
        zoom: 1,
        minZoom: 1,
      });

      map.addControl(new NavigationControl({ showCompass: false }), "top-right");

      chapters.forEach((chapter) => {
        const popup = new Popup({ offset: 16 }).setHTML(
          `<strong>${chapter.name}</strong><br>${chapter.members} ${chapter.members === 1 ? "member" : "members"}`
        );
        new Marker({ color: "#b5563a" })
          .setLngLat([chapter.lng, chapter.lat])
          .setPopup(popup)
          .addTo(map);
      });
    }
  }

  initSite();
</script>