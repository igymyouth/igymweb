---
import Layout from "../layouts/Layout.astro";
import FaultLine from "../components/FaultLine.astro";


// Each member optionally supports a bio field for chapters that want to add
// short profiles later, e.g. { name: "...", bio: "..." }
import { db } from "../lib/firebase.js";
import { collection, getDocs } from "firebase/firestore";

const snapshot = await getDocs(collection(db, "Chapters"));
const chapters = snapshot.docs.map((doc) => {
  const data = doc.data();
  return {
    name: data.name,
    flag: data.flag,
    members: data.memberList.map((m) => ({ name: m })),
  };
});

const totalMembers = chapters.reduce((sum, c) => sum + c.members.length, 0);
---

<Layout title="Youth Leaders" description="Meet the students coordinating I-GYM chapters around the world.">
  <section class="intro">
    <div class="container">
      <p class="eyebrow">Youth Leaders</p>
      <h1>Run by students, chapter by chapter.</h1>
      <p class="lede">
        I-GYM is coordinated entirely by its own members. {totalMembers} students across {chapters.length}
        chapters and countries keep the movement running — here's who's involved right now.
      </p>
    </div>
  </section>

  <FaultLine from="var(--stone)" to="var(--paper)" />

  <section class="chapters" style="background: var(--paper);">
    <div class="container">
      <p class="eyebrow">Chapters</p>
      <div class="chapter-grid">
        {chapters.map((c) => (
          <article class="card chapter-card">
            <div class="chapter-head">
              <h3><span class="flag" aria-hidden="true">{c.flag}</span> {c.name}</h3>
              <span class="tag">{c.members.length} {c.members.length === 1 ? "member" : "members"}</span>
            </div>
            <ul class="member-list">
              {c.members.map((m) => (
                <li>
                  <span class="member-name">{m.name}</span>
                  {m.bio && <p class="member-bio">{m.bio}</p>}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta dark">
    <div class="container cta-inner">
      <div>
        <p class="eyebrow">Want to be on this page?</p>
        <h2>Chapters are always looking for their next coordinator.</h2>
      </div>
      <a href="/get-involved" class="btn btn-primary">See open roles</a>
    </div>
  </section>
</Layout>

<style>
  .intro { padding-block: clamp(3rem, 7vw, 5rem); }
  .intro .lede { font-size: var(--step-1); max-width: 58ch; }

  .chapters { padding-block: clamp(3rem, 7vw, 5rem); }

  .chapter-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .chapter-card { display: flex; flex-direction: column; }
  .chapter-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .chapter-head h3 { font-size: var(--step-1); margin: 0; }
  .flag { font-size: 1.05em; }
  .chapter-head .tag {
    white-space: nowrap;
    font-size: 0.75rem;
    color: var(--rust);
    border-color: var(--rust);
  }

  .member-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .member-list li {
    padding-block: 0.25rem;
    border-bottom: 1px solid var(--stone);
  }
  .member-list li:last-child { border-bottom: none; }
  .member-name {
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .member-bio {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .cta { padding-block: clamp(2.5rem, 6vw, 4rem); }
  .cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .cta-inner h2 { margin-bottom: 0; }

  @media (max-width: 1100px) {
    .chapter-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 700px) {
    .chapter-grid { grid-template-columns: 1fr; }
  }
</style>